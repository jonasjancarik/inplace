{
  "name": "inplace-html",
  "version": "0.1.0",
  "description": "Write with your coding agent without breaking your flow: edit HTML documents your agent wrote right in the browser, and leave comments for the bigger changes.",
  "license": "MIT",
  "author": "Jonas Jancarik",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonasjancarik/inplace.git"
  },
  "type": "module",
  "bin": {
    "inplace": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "agent-guide.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && tsc -p src/editor",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepare": "tsc && tsc -p src/editor",
    "test:e2e": "npm run build && playwright test",
    "record-demo": "npm run build && node scripts/record-demo.mjs"
  },
  "dependencies": {
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
